<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.accubook</groupId><artifactId>accubook-desktop</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>accubook-ui-shell</artifactId>
  <name>AccuBook :: UI Shell</name>
  <description>JavaFX shell. Never imports a feature module.</description>
  <dependencies>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-platform</artifactId></dependency>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-app</artifactId></dependency>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-accounting</artifactId></dependency>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-module-api</artifactId></dependency>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version></dependency>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId><version>${javafx.version}</version></dependency>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId><version>${javafx.version}</version></dependency>
    <dependency><groupId>org.testfx</groupId><artifactId>testfx-junit5</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!--
            UI tests run against a real X display - Xvfb on CI and here:
              xvfb-run -a -s "-screen 0 1280x1024x24" mvn verify -Daccubook.ui.tests=true
            Monocle (headless glass) is not used: every published build targets
            JDK 12-era JavaFX internals and fails on JavaFX 17 with
            AbstractMethodError on MonocleWindow._updateViewSize.

            TestFX reads and sets JavaFX launch internals reflectively; these
            opens are test-only scaffolding, never needed by the application.

            The end-to-end test seeds a posted company through the posting core
            before the shell starts, which needs persistence. The shell module
            itself must never read persistence, so the read is granted to the
            test JVM only.
          -->
          <argLine>
            --add-exports javafx.graphics/com.sun.glass.ui=ALL-UNNAMED
            --add-opens javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
            --add-reads accubook.ui.shell=accubook.persistence
          </argLine>
          <systemPropertyVariables>
            <testfx.robot>glass</testfx.robot>
            <!-- Software rendering: Xvfb has no GPU. -->
            <prism.order>sw</prism.order>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
