<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.accubook</groupId><artifactId>accubook-desktop</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>accubook-integration-tests</artifactId>
  <name>AccuBook :: Integration tests</name>
  <description>
    Tests that exercise several modules together - documents with inventory,
    for instance. Deliberately NOT a JPMS module: it runs on the classpath, so
    neither Maven nor the IDE needs test-only module reads, and no production
    module has to read another just so its tests can.
  </description>
  <dependencies>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-trade</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-inventory</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-app</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-sales-invoicing</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-purchase-billing</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-sales-orders</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-purchase-orders</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-taxation-returns</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-banking</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-ui-inventory</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-ui-banking</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.accubook</groupId><artifactId>accubook-ui-trade</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.testfx</groupId><artifactId>testfx-junit5</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!-- Feature screens' UI tests (Phase 11S) need a display, as the shell's do. -->
          <systemPropertyVariables>
            <testfx.robot>glass</testfx.robot>
            <prism.order>sw</prism.order>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
